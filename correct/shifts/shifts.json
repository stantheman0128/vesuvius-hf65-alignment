{
 "description": "Per-segment canvas -> tifxyz offsets for the ink training segments of hf://buckets/scrollprize/datasets/ink/ (villa#2370 and the 2026-10-30 ink bucket audit)",
 "convention": {
  "units": "level-0 canvas pixels; slopes are pixels per pixel",
  "canvas": "(y, x) = level-0 pixel of <segment>.zarr in hf://buckets/scrollprize/datasets/ink/<scroll>/<segment>/; the ink labels and supervision masks there share this grid; pixel centres at integers",
  "tifxyz": "(ty, tx) = full-resolution cell of the tifxyz (x.tif, y.tif, z.tif, meta.json) in the same folder, villa convention: full-res cell (r, c) is stored cell (r * scale_y, c * scale_x), bilinear (vesuvius tifxyz/types.py:153-154)",
  "model": "canvas content at (y, x) lies at tifxyz cell (y + dy, x + dx), with dy = dy_a + dy_per_y * y + dy_per_x * x and dx = dx_a + dx_per_y * y + dx_per_x * x, evaluated at canvas coordinates (same sign and form as correct/apply_fit.py)",
  "full_3d": "villa full_3d pairs label pixel (y, x) with tifxyz cell (y, x); the label value that belongs to tifxyz cell (ty, tx) is the canvas/label value at inv(ty, tx)",
  "measurement_offset": "the same measurement reads +0.4 to +0.5 px on both axes on the five aligned segments; the parameters are the measured values and do not remove it (as in apply_fit.py)"
 },
